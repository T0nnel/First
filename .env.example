# ==============================
# ToolHub Environment Variables
# ==============================

# Your live domain — set this in Vercel Dashboard → Settings → Environment Variables
# On Vercel this is set automatically, but override if you have a custom domain:
NEXT_PUBLIC_SITE_URL=https://toolhub.vercel.app

# Google Analytics — replace with your real GA4 Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google AdSense Publisher ID
NEXT_PUBLIC_ADSENSE_ID=ca-pub-8193538495795562

# Contact email shown on pages
NEXT_PUBLIC_CONTACT_EMAIL=hello@toolhub.app
